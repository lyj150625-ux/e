<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>e-Based Perfect Two-way Translator (Spaced)</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f0f4f8;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
            padding: 20px;
            box-sizing: border-box;
        }
        .container {
            background-color: white;
            padding: 30px;
            border-radius: 16px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.08);
            text-align: center;
            max-width: 550px;
            width: 100%;
            box-sizing: border-box;
        }
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }
        select {
            padding: 6px 10px;
            border-radius: 6px;
            border: 1px solid #ccc;
            font-size: 14px;
            cursor: pointer;
        }
        h1 {
            font-size: 22px;
            color: #2c3e50;
            margin: 0;
            text-align: left;
        }
        p {
            color: #7f8c8d;
            font-size: 13px;
            margin: 10px 0 20px 0;
            text-align: left;
            line-height: 1.4;
        }
        .section {
            background: #f8f9fa;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            padding: 15px;
            margin-bottom: 20px;
            text-align: left;
        }
        .section-title {
            font-weight: bold;
            font-size: 14px;
            color: #2c3e50;
            margin-bottom: 10px;
            display: block;
        }
        textarea {
            width: 100%;
            height: 80px;
            padding: 10px;
            border: 1px solid #cbd5e1;
            border-radius: 8px;
            font-size: 15px;
            box-sizing: border-box;
            resize: none;
            font-family: inherit;
        }
        textarea:focus {
            border-color: #3498db;
            outline: none;
        }
        .arrow {
            font-size: 24px;
            color: #94a3b8;
            margin: 10px 0;
            text-align: center;
        }
    </style>
</head>
<body>

<div class="container">
    <div class="header">
        <h1 id="title">e 기반 양방향 난수 번역기</h1>
        <select id="langSelect" onchange="changeLanguage()">
            <option value="ko">한국어</option>
            <option value="en">English</option>
            <option value="ja">日本語</option>
        </select>
    </div>
    <p id="desc">글자당 고유한 5자리 난수를 생성하며, 글자별 식별이 쉽도록 띄어쓰기로 구분됩니다. 복사하여 붙여넣으면 언제 어디서나 동일하게 복원됩니다.</p>

    <!-- 텍스트 -> 난수 변환 -->
    <div class="section">
        <span class="section-title" id="textToNumLabel">텍스트 입력 ➔ 난수 생성</span>
        <textarea id="sourceText" placeholder="텍스트를 입력하면 난수로 변환됩니다..." oninput="textToRandom()"></textarea>
        <div class="arrow">⬇</div>
        <textarea id="targetNum" placeholder="변환된 난수가 여기에 표시됩니다..." readonly onclick="this.select()"></textarea>
    </div>

    <!-- 난수 -> 텍스트 복원 -->
    <div class="section">
        <span class="section-title" id="numToTextLabel">난수 입력 ➔ 원문 복원</span>
        <textarea id="sourceNum" placeholder="위에서 생성된 난수를 여기에 붙여넣으세요..." oninput="randomToText()"></textarea>
        <div class="arrow">⬇</div>
        <textarea id="targetText" placeholder="복원된 원문 텍스트가 여기에 표시됩니다..." readonly></textarea>
    </div>
</div>

<script>
    // 자연상수 e의 고정 상수값 오프셋
    const E_KEY = 27182;

    const i18n = {
        ko: {
            title: "e 기반 양방향 난수 번역기",
            desc: "글자당 고유한 5자리 난수를 생성하며, 글자별 식별이 쉽도록 띄어쓰기로 구분됩니다. 복사하여 붙여넣으면 언제 어디서나 동일하게 복원됩니다.",
            p1: "텍스트를 입력하면 난수로 변환됩니다...",
            p2: "변환된 난수가 여기에 표시됩니다...",
            p3: "위에서 생성된 난수를 여기에 붙여넣으세요...",
            p4: "복원된 원문 텍스트가 여기에 표시됩니다...",
            textToNumLabel: "텍스트 입력 ➔ 난수 생성",
            numToTextLabel: "난수 입력 ➔ 원문 복원"
        },
        en: {
            title: "e-Based Two-way Random Translator",
            desc: "Generates a unique 5-digit random number per character, separated by spaces for clarity. Guarantees perfect restoration anywhere.",
            p1: "Enter text to convert to a random number...",
            p2: "The converted random number will appear here...",
            p3: "Paste the generated random number here...",
            p4: "The restored original text will appear here...",
            textToNumLabel: "Text Input ➔ Random Generation",
            numToTextLabel: "Random Input ➔ Text Restoration"
        },
        ja: {
            title: "eベース双方向乱数翻訳機",
            desc: "文字ごとに固有の5桁の乱数を生成し、識別しやすいようにスペースで区切られます。貼り付けると、いつでもどこでも同じように復元されます。",
            p1: "テキストを入力すると乱数に変換されます...",
            p2: "変換された乱数がここに表示されます...",
            p3: "上で生成された乱数をここに貼り付けてください...",
            p4: "復元された原文テキストがここに表示されます...",
            textToNumLabel: "テキスト入力 ➔ 乱数生成",
            numToTextLabel: "乱数入力 ➔ 原文復元"
        }
    };

    function changeLanguage() {
        const lang = document.getElementById("langSelect").value;
        document.getElementById("title").innerText = i18n[lang].title;
        document.getElementById("desc").innerText = i18n[lang].desc;
        document.getElementById("sourceText").placeholder = i18n[lang].p1;
        document.getElementById("targetNum").placeholder = i18n[lang].p2;
        document.getElementById("sourceNum").placeholder = i18n[lang].p3;
        document.getElementById("targetText").placeholder = i18n[lang].p4;
        document.getElementById("textToNumLabel").innerText = i18n[lang].textToNumLabel;
        document.getElementById("numToTextLabel").innerText = i18n[lang].numToTextLabel;
        
        textToRandom();
        randomToText();
    }

    // 텍스트 -> 5자리 난수 변환 (5자리마다 스페이스바 추가)
    function textToRandom() {
        const text = document.getElementById("sourceText").value;
        if (!text) {
            document.getElementById("targetNum").value = "";
            return;
        }

        let resultChunks = [];
        for (let i = 0; i < text.length; i++) {
            const code = text.charCodeAt(i);
            let crypt = code + E_KEY;
            let cryptStr = String(crypt).padStart(5, '0');
            resultChunks.push(cryptStr);
        }
        
        // 5자리 묶음들을 한 칸씩 띄워서 출력
        document.getElementById("targetNum").value = resultChunks.join(" ");
    }

    // 5자리 고정 난수 -> 원래 텍스트 역연산 복원 (공백 유무 상관없이 처리)
    function randomToText() {
        // 입력 창에서 공백이나 숫자가 아닌 쓰레기 문자들은 전부 제거 후 순수 숫자만 취합
        const numStr = document.getElementById("sourceNum").value.trim().replace(/[^0-9]/g, '');
        if (!numStr) {
            document.getElementById("targetText").value = "";
            return;
        }

        let restoredText = "";
        
        // 순수 숫자 배열을 5자리씩 끊어서 문자로 역산
        for (let i = 0; i < numStr.length; i += 5) {
            const chunk = numStr.substring(i, i + 5);
            if (chunk.length === 5) {
                const crypt = parseInt(chunk, 10);
                const code = crypt - E_KEY;
                
                if (code >= 0) {
                    restoredText += String.fromCharCode(code);
                }
            }
        }

        document.getElementById("targetText").value = restoredText;
    }
</script>

</body>
</html>
